{
    "$schema": "https://json.schemastore.org/jsconfig",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES6",
        "jsx": "react-jsx",
        "checkJs": false,
        "skipLibCheck": true,
        "disableSizeLimit": false,
        // "baseUrl": "."
    },
    "typeAcquisition": {
        "enable": false
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build",
        ".next",
        "coverage"
    ]
}
